#!/usr/bin/env bash
set -euo pipefail

TOOLKIT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Groups own their own skills/ and runners/: <group>/skills/<name>, <group>/runners/<name>.
# A group is "primitives", "general", or "flows/<flow>". accounts.json maps an
# account to the groups it installs.
TOOLKIT_ROOT="$TOOLKIT_DIR"
META_DIR="$TOOLKIT_DIR/.toolkit"
DISABLED_FILE="$META_DIR/disabled.json"
ACCOUNTS_FILE="$TOOLKIT_DIR/accounts.json"

ZSHRC="$HOME/.zshrc"

SENTINEL_BEGIN="# >>> agent-toolkit runners >>>"
SENTINEL_END="# <<< agent-toolkit runners <<<"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

ensure_meta_dir() {
  [[ -d "$META_DIR" ]] || mkdir -p "$META_DIR"
  if [[ ! -f "$DISABLED_FILE" ]]; then
    printf '{\n  "skills": [],\n  "runners": []\n}\n' > "$DISABLED_FILE"
  fi
}

is_disabled() {
  local type="$1" name="$2"
  [[ ! -f "$DISABLED_FILE" ]] && return 1
  python3 -c "
import json, sys
d = json.load(open('$DISABLED_FILE'))
sys.exit(0 if '$name' in d.get('$type', []) else 1)
"
}

set_disabled() {
  local type="$1" name="$2" action="$3"
  ensure_meta_dir
  python3 -c "
import json
path = '$DISABLED_FILE'
d = json.load(open(path))
lst = d.setdefault('$type', [])
if '$action' == 'add' and '$name' not in lst:
    lst.append('$name')
    lst.sort()
elif '$action' == 'remove' and '$name' in lst:
    lst.remove('$name')
d['$type'] = lst
json.dump(d, open(path, 'w'), indent=2)
print()
"
}

owns_symlink() {
  local link="$1"
  [[ -L "$link" ]] || return 1
  local target
  target="$(readlink "$link")"
  [[ "$target" == "$TOOLKIT_ROOT/"* ]]
}

# Every <group>/skills/<name>/SKILL.md in the tree. Prints "<group><TAB><name>".
available_skills() {
  local f rel group name
  while IFS= read -r f; do
    rel="${f#"$TOOLKIT_ROOT"/}"            # <group>/skills/<name>/SKILL.md
    rel="${rel%/SKILL.md}"                 # <group>/skills/<name>
    name="${rel##*/}"
    group="${rel%/skills/$name}"
    printf '%s\t%s\n' "$group" "$name"
  done < <(find "$TOOLKIT_ROOT" -path '*/skills/*/SKILL.md' -type f -not -path '*/.git/*' 2>/dev/null | sort)
}

# Every <group>/runners/<name>/runner.json. Prints "<group><TAB><name>".
available_runners_grouped() {
  local f rel group name
  while IFS= read -r f; do
    rel="${f#"$TOOLKIT_ROOT"/}"
    rel="${rel%/runner.json}"
    name="${rel##*/}"
    group="${rel%/runners/$name}"
    printf '%s\t%s\n' "$group" "$name"
  done < <(find "$TOOLKIT_ROOT" -path '*/runners/*/runner.json' -type f -not -path '*/.git/*' 2>/dev/null | sort)
}

available_runners() { available_runners_grouped | awk -F'\t' '{print $2}'; }

runner_group() { available_runners_grouped | awk -F'\t' -v n="$1" '$2 == n && !s { print $1; s=1 }'; }
runner_dir()   { local g; g="$(runner_group "$1")"; [[ -z "$g" ]] && return 1; printf '%s/%s/runners/%s\n' "$TOOLKIT_ROOT" "$g" "$1"; }

skill_group() {
  # No `exit` on match: quitting awk early closes the pipe, and SIGPIPE under
  # `set -o pipefail` fails the whole command substitution.
  available_skills | awk -F'\t' -v n="$1" '$2 == n && !seen { print $1; seen = 1 }'
}

skill_src() {
  local group
  group="$(skill_group "$1")"
  [[ -z "$group" ]] && return 1
  printf '%s/%s/skills/%s\n' "$TOOLKIT_ROOT" "$group" "$1"
}

# Names of the skills belonging to the given groups (space-separated string).
skills_in_groups() {
  local groups=" $1 " group name
  while IFS=$'\t' read -r group name; do
    [[ "$groups" == *" $group "* ]] && printf '%s\n' "$name"
  done < <(available_skills)
}

# ---------------------------------------------------------------------------
# Accounts — which groups each Claude Code account installs
# ---------------------------------------------------------------------------

account_names() {
  python3 -c "
import json
print('\n'.join(json.load(open('$ACCOUNTS_FILE'))['accounts']))
"
}

account_field() {
  python3 -c "
import json, sys
a = json.load(open('$ACCOUNTS_FILE'))['accounts'].get('$1')
if a is None: sys.exit(1)
v = a['$2']
print(' '.join(v) if isinstance(v, list) else v)
"
}

account_target() {
  local dir
  dir="$(account_field "$1" config_dir)" || return 1
  printf '%s/skills\n' "${dir/#\~/$HOME}"
}

runner_entrypoint() {
  local name="$1"
  python3 -c "
import json
r = json.load(open('$(runner_dir "$name")/runner.json'))
print(r['entrypoint'])
"
}

runner_description() {
  local name="$1"
  python3 -c "
import json
r = json.load(open('$(runner_dir "$name")/runner.json'))
print(r.get('description', ''))
"
}

# ---------------------------------------------------------------------------
# Sync: skills
# ---------------------------------------------------------------------------

sync_skills() {
  local target="$1" groups="$2"
  local dry_run="${3:-false}" force="${4:-false}"
  local created=0 removed=0 skipped=0 kept=0

  if [[ ! -d "$target" ]]; then
    if [[ "$dry_run" == "true" ]]; then
      echo "  would create $target"
    else
      mkdir -p "$target"
    fi
  fi

  local wanted=()
  while IFS= read -r s; do [[ -n "$s" ]] && wanted+=("$s"); done < <(skills_in_groups "$groups")

  # Add symlinks for the skills this account's groups entitle it to
  local skill
  for skill in "${wanted[@]}"; do
    local link="$target/$skill"
    local src
    src="$(skill_src "$skill")"

    if is_disabled skills "$skill"; then
      # If disabled but our symlink exists, remove it
      if owns_symlink "$link"; then
        if [[ "$dry_run" == "true" ]]; then
          echo "  would remove $skill (disabled)"
        else
          rm "$link"
          echo "  removed $skill (disabled)"
        fi
        ((removed++))
      fi
      continue
    fi

    if [[ -L "$link" ]]; then
      local current_target
      current_target="$(readlink "$link")"
      if [[ "$current_target" == "$src" ]]; then
        ((kept++))
        continue
      fi
      if [[ "$current_target" == "$TOOLKIT_ROOT/"* ]]; then
        # Ours, but pointing at the old path — a regrouped skill lands here
        if [[ "$dry_run" == "true" ]]; then
          echo "  would regroup $skill → $src"
        else
          rm "$link"
          ln -s "$src" "$link"
          echo "  regrouped $skill"
        fi
        ((created++))
        continue
      fi
      if [[ "$force" == "true" ]]; then
        if [[ "$dry_run" == "true" ]]; then
          echo "  would replace $skill (was → $current_target)"
        else
          rm "$link"
          ln -s "$src" "$link"
          echo "  replaced $skill (was → $current_target)"
        fi
        ((created++))
        continue
      fi
      echo "  WARN: $skill exists as symlink to $current_target — skipping (use --force to replace)"
      ((skipped++))
      continue
    fi

    if [[ -e "$link" ]]; then
      echo "  WARN: $skill exists as a real directory — skipping"
      ((skipped++))
      continue
    fi

    if [[ "$dry_run" == "true" ]]; then
      echo "  would create $skill → $src"
    else
      ln -s "$src" "$link"
      echo "  created $skill"
    fi
    ((created++))
  done

  # Remove symlinks of ours that this account should no longer have — either the
  # skill is gone from skills/, or its group is not in this account's set.
  local want_list=" ${wanted[*]} "
  local link name
  for link in "$target"/*/; do
    [[ -e "$link" ]] || continue
    name="$(basename "$link")"
    [[ "$name" == .* ]] && continue
    owns_symlink "${link%/}" || continue
    [[ "$want_list" == *" $name "* ]] && continue

    local why="no longer in skills/"
    [[ -n "$(skill_group "$name")" ]] && why="not in this account's groups"
    if [[ "$dry_run" == "true" ]]; then
      echo "  would remove $name ($why)"
    else
      rm "${link%/}"
      echo "  removed $name ($why)"
    fi
    ((removed++))
  done

  echo "  skills: $created changed, $kept unchanged, $removed removed, $skipped skipped"
}

# ---------------------------------------------------------------------------
# Sync: runners (managed block in .zshrc)
# ---------------------------------------------------------------------------

build_alias_block() {
  echo "$SENTINEL_BEGIN"
  for runner in $(available_runners); do
    is_disabled runners "$runner" && continue
    local entrypoint
    entrypoint="$(runner_entrypoint "$runner")"
    echo "alias $runner=\"$(runner_dir "$runner")/$entrypoint\""
  done
  echo "$SENTINEL_END"
}

sync_runners() {
  local dry_run="${1:-false}"

  local new_block
  new_block="$(build_alias_block)"

  if [[ ! -f "$ZSHRC" ]]; then
    echo "  WARN: $ZSHRC not found — skipping runner aliases"
    return
  fi

  # Check for conflicting aliases outside the managed block
  for runner in $(available_runners); do
    is_disabled runners "$runner" && continue
    local pattern="alias ${runner}="
    local conflicts
    conflicts="$(sed "/$SENTINEL_BEGIN/,/$SENTINEL_END/d" "$ZSHRC" | grep -n "$pattern" || true)"
    if [[ -n "$conflicts" ]]; then
      echo "  WARN: found existing alias '$runner' outside managed block:"
      echo "        $conflicts"
      echo "        remove it manually to avoid conflicts"
    fi
  done

  if grep -qF "$SENTINEL_BEGIN" "$ZSHRC"; then
    # Extract current block
    local current_block
    current_block="$(sed -n "/$SENTINEL_BEGIN/,/$SENTINEL_END/p" "$ZSHRC")"
    if [[ "$current_block" == "$new_block" ]]; then
      echo "  runners: no changes"
      return
    fi
    if [[ "$dry_run" == "true" ]]; then
      echo "  would update managed block in $ZSHRC:"
      echo "$new_block" | sed 's/^/    /'
    else
      # Replace the block in-place
      local tmp new_tmp
      tmp="$(mktemp)"
      new_tmp="$(mktemp)"
      echo "$new_block" > "$new_tmp"
      awk -v begin="$SENTINEL_BEGIN" -v end="$SENTINEL_END" -v newfile="$new_tmp" '
        $0 == begin { while ((getline line < newfile) > 0) print line; close(newfile); skip=1; next }
        $0 == end { skip=0; next }
        !skip { print }
      ' "$ZSHRC" > "$tmp"
      mv "$tmp" "$ZSHRC"
      rm -f "$new_tmp"
      echo "  runners: updated managed block in $ZSHRC"
    fi
  else
    if [[ "$dry_run" == "true" ]]; then
      echo "  would append managed block to $ZSHRC:"
      echo "$new_block" | sed 's/^/    /'
    else
      printf '\n%s\n' "$new_block" >> "$ZSHRC"
      echo "  runners: appended managed block to $ZSHRC"
    fi
  fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_sync() {
  local dry_run="false" force="false" accounts=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run="true"; shift ;;
      --force)   force="true"; shift ;;
      --account) accounts+=("${2:-}"); shift 2 ;;
      --all)     shift ;;   # default; kept for explicitness
      *) echo "Unknown option: $1"; exit 1 ;;
    esac
  done

  ensure_meta_dir

  # No --account given: sync every account in accounts.json.
  if [[ ${#accounts[@]} -eq 0 ]]; then
    while IFS= read -r a; do accounts+=("$a"); done < <(account_names)
  fi

  if [[ "$dry_run" == "true" ]]; then
    echo "Dry run — no changes will be made"
    echo ""
  fi

  # Per-account groups only mean something if the accounts have distinct trees.
  # If two <config-dir>/skills resolve to one directory (e.g. both symlinked at a
  # shared library), the second account's sync silently strips the first's skills.
  local seen_targets=() a t resolved
  for a in "${accounts[@]}"; do
    t="$(account_target "$a")" || { echo "Unknown account: $a (see accounts.json)"; exit 1; }
    resolved="$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$t")"
    local prev
    for prev in "${seen_targets[@]:-}"; do
      if [[ "$prev" == "$resolved" ]]; then
        echo "ERROR: two accounts share one skills directory ($resolved)."
        echo "  Per-account groups cannot work through a shared tree — syncing one"
        echo "  account would remove the other's skills."
        echo "  Fix: make each <config-dir>/skills its own directory, e.g."
        echo "    rm '$t' && mkdir -p '$t'"
        exit 1
      fi
    done
    seen_targets+=("$resolved")
  done

  local account target groups
  for account in "${accounts[@]}"; do
    target="$(account_target "$account")" || { echo "Unknown account: $account (see accounts.json)"; exit 1; }
    groups="$(account_field "$account" groups)"
    echo "Skills — $account ($target)"
    echo "  groups: $groups"
    sync_skills "$target" "$groups" "$dry_run" "$force"
    echo ""
  done

  echo "Runners ($ZSHRC):"
  sync_runners "$dry_run"
}

cmd_disable() {
  local name="${1:-}"
  [[ -z "$name" ]] && { echo "Usage: toolkit disable <skill-or-runner>"; exit 1; }

  ensure_meta_dir

  if [[ -n "$(skill_group "$name")" ]]; then
    set_disabled skills "$name" add
    echo "Disabled skill: $name"
    echo "Run './toolkit sync' to apply"
  elif [[ -n "$(runner_group "$name")" ]]; then
    set_disabled runners "$name" add
    echo "Disabled runner: $name"
    echo "Run './toolkit sync' to apply"
  else
    echo "Unknown skill or runner: $name"
    exit 1
  fi
}

cmd_enable() {
  local name="${1:-}"
  [[ -z "$name" ]] && { echo "Usage: toolkit enable <skill-or-runner>"; exit 1; }

  ensure_meta_dir

  if [[ -n "$(skill_group "$name")" ]]; then
    set_disabled skills "$name" remove
    echo "Enabled skill: $name"
    echo "Run './toolkit sync' to apply"
  elif [[ -n "$(runner_group "$name")" ]]; then
    set_disabled runners "$name" remove
    echo "Enabled runner: $name"
    echo "Run './toolkit sync' to apply"
  else
    echo "Unknown skill or runner: $name"
    exit 1
  fi
}

cmd_status() {
  echo "Agent Toolkit Status"
  echo "===================="
  echo ""
  echo "Source: $TOOLKIT_DIR"
  echo ""

  local account target groups
  while IFS= read -r account; do
    target="$(account_target "$account")"
    groups="$(account_field "$account" groups)"
    echo "Account: $account → $target"
    echo "  groups: $groups"

    local group name state link
    while IFS=$'\t' read -r group name; do
      link="$target/$name"
      if [[ " $groups " != *" $group "* ]]; then
        continue
      elif is_disabled skills "$name"; then
        state="disabled"
      elif owns_symlink "$link" 2>/dev/null; then
        state="installed"
      elif [[ -L "$link" ]]; then
        state="conflict (→ $(readlink "$link"))"
      elif [[ -e "$link" ]]; then
        state="conflict (real directory)"
      else
        state="not installed"
      fi
      printf "  %-18s %-32s %s\n" "$group" "$name" "$state"
    done < <(available_skills)

    # Ours, installed here, but no longer entitled
    for link in "$target"/*/; do
      [[ -e "$link" ]] || continue
      name="$(basename "$link")"
      [[ "$name" == .* ]] && continue
      owns_symlink "${link%/}" || continue
      group="$(skill_group "$name")"
      if [[ -z "$group" ]]; then
        printf "  %-18s %-32s %s\n" "-" "$name" "orphaned (no longer in skills/)"
      elif [[ " $groups " != *" $group "* ]]; then
        printf "  %-18s %-32s %s\n" "$group" "$name" "stale (group not in this account)"
      fi
    done
    echo ""
  done < <(account_names)

  echo "Runners:"
  local runner desc state
  for runner in $(available_runners); do
    desc="$(runner_description "$runner")"
    if is_disabled runners "$runner"; then
      state="disabled"
    elif grep -qF "$SENTINEL_BEGIN" "$ZSHRC" 2>/dev/null && \
         sed -n "/$SENTINEL_BEGIN/,/$SENTINEL_END/p" "$ZSHRC" | grep -q "alias ${runner}="; then
      state="installed"
    else
      state="not installed"
    fi
    printf "  %-18s %-16s %-10s %s\n" "$(runner_group "$runner")" "$runner" "$state" "$desc"
  done
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

case "${1:-status}" in
  sync)    shift; cmd_sync "$@" ;;
  disable) cmd_disable "${2:-}" ;;
  enable)  cmd_enable "${2:-}" ;;
  status)  cmd_status ;;
  *)
    echo "Usage: toolkit <command>"
    echo ""
    echo "Commands:"
    echo "  sync [--dry-run] [--force] [--account <name>]"
    echo "                              Install each account's skill groups + runner aliases"
    echo "                              (no --account syncs every account in accounts.json)"
    echo "  disable <name>              Disable a skill or runner"
    echo "  enable <name>               Re-enable a skill or runner"
    echo "  status                      Show current state (default)"
    ;;
esac
