#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$SCRIPT_DIR/lib/helpers.py"
SCHEMA="$SCRIPT_DIR/schemas/round-schema.json"
PROMPTS_ROOT="$SCRIPT_DIR/prompts"
REVIEWS_DIR=".reviews"

CLAUDE_MODEL="${REVIEW_CLAUDE_MODEL:-claude-opus-4-6}"
CODEX_MODEL="${REVIEW_CODEX_MODEL:-gpt-5.5}"

# ── Argument parsing ────────────────────────────────────────────────────────

CRITERIA=""
PR=""
# Base branch is tier-2 config, not a constant: derive it from the repo's own
# default branch so this works in a GitHub Flow repo (main) and a GitFlow one
# (develop) alike. --base still overrides.
default_base() {
  local d
  d="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)" && [[ -n "$d" ]] && { printf '%s\n' "${d#origin/}"; return 0; }
  for d in main master develop; do
    git rev-parse --verify --quiet "$d" >/dev/null 2>&1 && { printf '%s\n' "$d"; return 0; }
  done
  printf 'main\n'
}
BASE=""
ROUNDS=3
DRY_RUN=0
INCLUDE_ALL=0
PROFILE=""
FILES=()

usage() {
  cat <<'EOF'
review-loop — adversarial review of code or documents (Claude + Codex)

Usage:
  review-loop --criteria <path> [options]

Options:
  --criteria <path>    Criteria file or directory (required)
  --files <path>       Review these files as-is instead of a diff (repeatable).
                       Use for plans, specs and design docs.
  --profile <name>     Prompt set: code | coherence (default: inferred from target)
  --pr <N|URL>         PR number or GitHub URL to review
  --base <branch>      Base branch for diff (default: the repo's default branch)
  --rounds <N>         Number of review rounds (default: 3)
  --output-dir <path>  Output directory for reviews (default: .reviews/)
  --dry-run            Show what would happen without running reviews
  --include-all        Disable default exclusion of lock/generated files

Examples:
  review-loop --criteria docs/PR_REVIEW_CRITERIA.md --pr 42
  review-loop --criteria docs/agentic/ --base main
  review-loop --criteria criteria.md --pr 42 --rounds 2
  review-loop --files docs/BUILD_PLAN.md --criteria "$(dirname "$0")/criteria/coherence.md"
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --criteria) CRITERIA="$2"; shift 2 ;;
    --files)    FILES+=("$2"); shift 2 ;;
    --profile)  PROFILE="$2"; shift 2 ;;
    --pr)       PR="$2"; shift 2 ;;
    --base)     BASE="$2"; shift 2 ;;
    --rounds)   ROUNDS="$2"; shift 2 ;;
    --output-dir) REVIEWS_DIR="$2"; shift 2 ;;
    --dry-run)  DRY_RUN=1; shift ;;
    --include-all) INCLUDE_ALL=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          echo "error: unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

[[ -z "$BASE" ]] && BASE="$(default_base)"
[[ -z "$BASE" ]] && BASE="main"

if [[ -z "$CRITERIA" ]]; then
  echo "error: --criteria is required." >&2
  echo "" >&2
  echo "The review-loop tool requires explicit criteria docs to grade against." >&2
  echo "For a general-purpose review without criteria, use: /code-review" >&2
  exit 1
fi

if [[ ! -e "$CRITERIA" ]]; then
  echo "error: criteria path not found: $CRITERIA" >&2
  exit 1
fi

# ── Diff filtering ─────────────────────────────────────────────────────────

EXCLUDE_PATTERNS=(
  'Cargo.lock'
  'pnpm-lock.yaml'
  'yarn.lock'
  'package-lock.json'
  'gen/schemas/*'
  'generated/*'
  '*.min.js'
  '*.min.css'
)

filter_diff() {
  local patterns
  patterns=$(printf '%s\n' "${EXCLUDE_PATTERNS[@]}")
  FILTER_PATTERNS="$patterns" python3 -c "
import sys, fnmatch, re, os

patterns = os.environ['FILTER_PATTERNS'].splitlines()
lines = sys.stdin.read()
chunks = re.split(r'(?=^diff --git )', lines, flags=re.MULTILINE)
kept = []
excluded = []
for chunk in chunks:
    if not chunk.strip():
        continue
    match = re.match(r'diff --git a/(.*?) b/(.*)', chunk)
    if match:
        path = match.group(2).split('\n')[0]
        basename = path.rsplit('/', 1)[-1] if '/' in path else path
        skip = any(
            fnmatch.fnmatch(path, p) or
            fnmatch.fnmatch(path, '*/' + p) or
            fnmatch.fnmatch(basename, p)
            for p in patterns
        )
        if skip:
            excluded.append(path)
            continue
    kept.append(chunk)
if excluded:
    print(f'  filtered: {len(excluded)} file(s) excluded (lock/generated)', file=sys.stderr)
    for e in excluded:
        print(f'    - {e}', file=sys.stderr)
print(''.join(kept), end='')
"
}

# ── Target mode & profile ───────────────────────────────────────────────────
#
# Two target adapters: a git diff (code review) or a set of files read as-is
# (plans, specs, design docs). Everything downstream — rounds, criteria, schema,
# assembly — is identical; only what gets put in front of the models differs.

if [[ ${#FILES[@]} -gt 0 ]]; then
  MODE="files"
  [[ -n "$PR" ]] && { echo "error: --files and --pr are mutually exclusive" >&2; exit 1; }
else
  MODE="diff"
fi

[[ -z "$PROFILE" ]] && { [[ "$MODE" == "files" ]] && PROFILE="coherence" || PROFILE="code"; }

PROMPTS_DIR="$PROMPTS_ROOT/$PROFILE"
if [[ ! -d "$PROMPTS_DIR" ]]; then
  echo "error: unknown profile '$PROFILE' (no prompts at $PROMPTS_DIR)" >&2
  echo "available: $(cd "$PROMPTS_ROOT" && ls -d */ 2>/dev/null | tr -d / | tr '\n' ' ')" >&2
  exit 1
fi

# ── Diff acquisition ────────────────────────────────────────────────────────

get_raw_diff() {
  if [[ -n "$PR" ]]; then
    local pr_num="$PR"
    if [[ "$PR" == http* ]]; then
      pr_num="${PR##*/}"
    fi
    gh pr diff "$pr_num"
  else
    git diff "$BASE"...HEAD
  fi
}

get_diff() {
  if [[ "$INCLUDE_ALL" == 1 ]]; then
    get_raw_diff
  else
    get_raw_diff | filter_diff
  fi
}

get_files_content() {
  local f
  for f in "${FILES[@]}"; do
    [[ -f "$f" ]] || { echo "error: file not found: $f" >&2; exit 1; }
    # Line-numbered so findings can cite a location the author can jump to.
    printf '### %s\n\n```\n' "$f"
    awk '{ printf "%6d  %s\n", NR, $0 }' "$f"
    printf '```\n\n'
  done
}

if [[ "$MODE" == "files" ]]; then
  DIFF=$(get_files_content)
else
  DIFF=$(get_diff)
fi

if [[ -z "$DIFF" ]]; then
  echo "No changes to review."
  exit 0
fi

# ── Target label for artifact naming ────────────────────────────────────────

if [[ "$MODE" == "files" ]]; then
  if [[ ${#FILES[@]} -eq 1 ]]; then
    TARGET="$(basename "${FILES[0]}" .md)"
  else
    TARGET="${#FILES[@]}-docs"
  fi
elif [[ -n "$PR" ]]; then
  TARGET="PR-${PR##*/}"
else
  BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
  TARGET="branch-${BRANCH}"
fi

TIMESTAMP=$(date +%Y%m%dT%H%M%S)
REVIEW_FILE="$REVIEWS_DIR/${TIMESTAMP}-${TARGET}.md"

# ── Dry run ─────────────────────────────────────────────────────────────────

if [[ "$DRY_RUN" == 1 ]]; then
  DIFF_LINES=$(echo "$DIFF" | wc -l | tr -d ' ')
  CRITERIA_DESC="$CRITERIA"
  if [[ -d "$CRITERIA" ]]; then
    CRITERIA_DESC="$CRITERIA/ ($(find "$CRITERIA" -name '*.md' | wc -l | tr -d ' ') files)"
  fi
  echo "review-loop dry run"
  echo "  criteria:  $CRITERIA_DESC"
  echo "  profile:   $PROFILE"
  echo "  target:    $TARGET"
  if [[ "$MODE" == "files" ]]; then
    echo "  files:     ${FILES[*]}"
  else
    echo "  base:      $BASE"
  fi
  echo "  rounds:    $ROUNDS"
  echo "  content:   $DIFF_LINES lines"
  echo "  claude:    $CLAUDE_MODEL"
  echo "  codex:     $CODEX_MODEL"
  if [[ "$MODE" == "diff" ]]; then
    if [[ "$INCLUDE_ALL" == 1 ]]; then
      echo "  filter:    disabled (--include-all)"
    else
      echo "  filter:    excluding lock/generated files"
    fi
  fi
  echo "  output:    $REVIEW_FILE"
  exit 0
fi

# ── Run directory setup ─────────────────────────────────────────────────────

mkdir -p "$REVIEWS_DIR"

if [[ "$REVIEWS_DIR" == ".reviews" ]]; then
  GITIGNORE="$(git rev-parse --show-toplevel 2>/dev/null)/.gitignore"
  if [[ -z "$(git rev-parse --show-toplevel 2>/dev/null)" ]]; then
    GITIGNORE=".gitignore"
  fi
  if ! grep -qxF '.reviews/' "$GITIGNORE" 2>/dev/null; then
    echo '.reviews/' >> "$GITIGNORE"
  fi
fi

WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

echo "$DIFF" > "$WORK_DIR/diff.txt"

echo "review-loop: $ROUNDS rounds, profile=$PROFILE, target=$TARGET, criteria=$CRITERIA"

# ── Round execution ─────────────────────────────────────────────────────────

run_claude_round() {
  local round_num="$1"
  local template="$2"
  shift 2
  local prior_args=("$@")

  echo "  round $round_num (Claude/$CLAUDE_MODEL)..."

  local build_args=(
    --template "$template"
    --criteria "$CRITERIA"
    --schema "$SCHEMA"
  )
  if [[ ${#prior_args[@]} -gt 0 ]]; then
    build_args+=(--prior "${prior_args[@]}")
  fi

  local prompt
  prompt=$(cat "$WORK_DIR/diff.txt" | python3 "$LIB" build-prompt "${build_args[@]}")

  local raw_output
  if ! raw_output=$(echo "$prompt" | claude -p --output-format json --model "$CLAUDE_MODEL" 2>/dev/null); then
    echo "    warning: claude invocation failed" >&2
    return 1
  fi

  echo "$raw_output" | python3 "$LIB" parse-claude --output "$WORK_DIR/round${round_num}.json"
  echo "    done."
}

run_codex_round() {
  local round_num="$1"
  local template="$2"
  shift 2
  local prior_args=("$@")

  echo "  round $round_num (Codex/$CODEX_MODEL)..."

  local build_args=(
    --template "$template"
    --criteria "$CRITERIA"
    --schema "$SCHEMA"
  )
  if [[ ${#prior_args[@]} -gt 0 ]]; then
    build_args+=(--prior "${prior_args[@]}")
  fi

  local prompt
  prompt=$(cat "$WORK_DIR/diff.txt" | python3 "$LIB" build-prompt "${build_args[@]}")

  if ! echo "$prompt" | codex exec -m "$CODEX_MODEL" \
    --output-schema "$SCHEMA" \
    -o "$WORK_DIR/round${round_num}.json" \
    - 2>/dev/null; then
    echo "    warning: codex invocation failed" >&2
    return 1
  fi

  echo "    done."
}

# ── Orchestration ───────────────────────────────────────────────────────────

round_files=()

for ((r = 1; r <= ROUNDS; r++)); do
  prior=()
  for ((p = 1; p < r; p++)); do
    if [[ -f "$WORK_DIR/round${p}.json" ]]; then
      prior+=("$WORK_DIR/round${p}.json")
    fi
  done

  if (( r % 2 == 1 )); then
    # Claude round (odd)
    if (( r == 1 )); then
      template="$PROMPTS_DIR/round1.md"
    else
      template="$PROMPTS_DIR/round3.md"
    fi

    if ! run_claude_round "$r" "$template" ${prior[@]+"${prior[@]}"}; then
      if (( r == 1 )); then
        echo "error: round 1 failed, aborting (nothing to challenge)" >&2
        exit 1
      fi
      echo "  skipping round $r due to failure, assembling with available data"
      continue
    fi
  else
    # Codex round (even)
    template="$PROMPTS_DIR/round2.md"

    if ! run_codex_round "$r" "$template" ${prior[@]+"${prior[@]}"}; then
      echo "  skipping round $r due to failure, assembling with available data"
      continue
    fi
  fi

  if [[ -f "$WORK_DIR/round${r}.json" ]]; then
    round_files+=("$WORK_DIR/round${r}.json")
  fi
done

# ── Artifact assembly ───────────────────────────────────────────────────────

if [[ ${#round_files[@]} -eq 0 ]]; then
  echo "error: no rounds completed successfully" >&2
  exit 1
fi

python3 "$LIB" assemble \
  --round-files "${round_files[@]}" \
  --target "$TARGET" \
  --profile "$PROFILE" \
  --criteria "$CRITERIA" \
  --output "$REVIEW_FILE"

echo ""
echo "review complete: $REVIEW_FILE"
